
public class Demo {
     static boolean  findTarget(int[] arr, int target){
        for(int i = 0; i < arr.length; i++){
            if(arr[i]==target){
                return true;
            }
        }
        return false;
     }
      
    }
    public static void main(String[] args) {
        int[] arr = {1,2,3,45,6};
        boolean ans = findTarget(arr,6);
        System.out.println(ans);
    }
