class Demo{

    static int unsortedElement(int[] arr){
        for(int i=0; i<arr.length-1; i++){
            if(arr[i+1]<=arr[i]){
                return arr[i+1];

            }
            
            }
            return -1;
        }
        public static void main(String[] args) {
            int[] arr = {1,2,3,4,56,6};
            System.out.println(unsortedElement(arr));
        }

    }
