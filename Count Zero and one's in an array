class Dmeo{
    static int[] countZeroOne(int[] arr){
        int zero=0;
        int one=0;
        for(int i=0; i<arr.length; i++){
            if(arr[i]==0){
                zero++;
            }else if(arr[i]==1){
                one++;
            }

        }
        int[] ans = {zero, one};
        return ans;
    }

    public static void main(String[] args){
        int[] arr = {0, 1, 0, 1, 1};
        int[] ans = countZeroOne(arr);
        System.out.println("count of zeros:" + ans[0]);
        System.out.println("count of ones:" + ans[1]);
    }
}
