public class Demo {
     static int[] multiply0(int[] arr){
      int size = arr.length;
      int newArray[] = new int[size];
      for(int i = 0; i<size; i++){
        int element = arr[i];
        newArray[i] = element*2;
      }
      return newArray;
      
    }
    public static void main(String[] args) {
        int[] arr = {1,2,3,45,6};
        int[] ans = multiply0(arr);

        for(int i : ans){
            System.out.print(i);
        }
    }
}
