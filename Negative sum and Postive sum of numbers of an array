class Dmeo{
    static int[] sumOfPosNeg(int[] arr){
        int sumPos=0;
        int sumNeg=0;
        for(int i=0; i<arr.length; i++){
            if(arr[i]>0){
                sumPos = sumPos + arr[i];
            }else if(arr[i]<0){
                sumNeg = sumNeg +arr[i];
            }

        }
        int[] ans = {sumPos, sumNeg};
        return ans;
    }

    public static void main(String[] args){
        int[] arr = {1,-2,-3,4,-5};
        int[] ans = sumOfPosNeg(arr);
        System.out.println("sum of positive nummbers:"+ ans[0]);
        System.out.println("sum of negative numbers:"+ ans[1]);
    }
